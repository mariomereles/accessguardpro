# Environment Configuration
NODE_ENV=production
PORT=5001

# Database
DATABASE_URL=postgresql://user:pass@host:5432/db

# Redis (optional for caching and locks)
REDIS_URL=redis://127.0.0.1:6379

# JWT keys: PEM contents (newlines may be written as \n). Generate with openssl.
# Without them a temporary pair is generated at startup and sessions/tickets break on restart.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Gate QR Secret (change in production)
GATE_HS_SECRET_DEFAULT=your_secure_random_string_here

# Hash chain salt for integrity
HASH_CHAIN_SALT=your_secure_random_string_here

# CORS Origin
CORS_ORIGIN=https://yourdomain.com

# Optional: Email service for notifications
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password